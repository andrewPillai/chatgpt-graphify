{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graphify Extraction Schema",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "file_type", "source_file"],
        "properties": {
          "id": { "type": "string", "description": "Unique identifier, e.g. 'filestem_entityname'" },
          "label": { "type": "string", "description": "Human-readable name" },
          "file_type": { "type": "string", "enum": ["code", "document", "paper", "image"] },
          "source_file": { "type": "string", "description": "Relative path to source file" },
          "source_location": { "type": ["string", "null"], "description": "Line number or location in source" },
          "source_url": { "type": ["string", "null"] },
          "captured_at": { "type": ["string", "null"] },
          "author": { "type": ["string", "null"] },
          "contributor": { "type": ["string", "null"] },
          "rationale": { "type": ["string", "null"], "description": "WHY decisions were made, trade-offs, design intent - stored on concept node" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "confidence", "confidence_score", "source_file", "weight"],
        "properties": {
          "source": { "type": "string", "description": "Source node ID" },
          "target": { "type": "string", "description": "Target node ID" },
          "relation": { 
            "type": "string", 
            "enum": ["calls", "implements", "references", "cites", "conceptually_related_to", "shares_data_with", "semantically_similar_to"]
          },
          "confidence": { "type": "string", "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"] },
          "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "source_file": { "type": "string" },
          "source_location": { "type": ["string", "null"] },
          "weight": { "type": "number", "default": 1.0 }
        }
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "nodes", "relation", "confidence", "confidence_score", "source_file"],
        "properties": {
          "id": { "type": "string", "description": "snake_case_id" },
          "label": { "type": "string", "description": "Human readable label" },
          "nodes": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
          "relation": { "type": "string", "enum": ["participate_in", "implement", "form"] },
          "confidence": { "type": "string", "enum": ["EXTRACTED", "INFERRED"] },
          "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "source_file": { "type": "string" }
        }
      }
    },
    "input_tokens": { "type": "integer", "default": 0 },
    "output_tokens": { "type": "integer", "default": 0 }
  },
  "required": ["nodes", "edges", "hyperedges", "input_tokens", "output_tokens"],
  "additionalProperties": false
}